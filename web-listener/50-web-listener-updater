Cmnd_Alias WEB_LISTENER_UPDATER = /usr/bin/systemctl start web-listener-updater
web-listener-runner ALL=(root) NOPASSWD: WEB_LISTENER_UPDATER

Cmnd_Alias WEB_LISTENER_RESTART = /usr/bin/systemctl restart web-listener8080, /usr/bin/systemctl restart web-listener8081
web-listener-updater ALL=(root) NOPASSWD: WEB_LISTENER_RESTART
