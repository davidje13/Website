[Unit]
Description=Web Listener Server ((PORT))
After=network.target

[Service]
Type=exec
User=web-listener-runner

# Start
Environment="PATH=/usr/local/bin:/usr/bin:/bin:/home/web-listener-updater/.local/bin"
ExecStart=/home/web-listener-updater/.local/bin/web-listener --config-file /var/www/web-listener/sites/config.json --port "((PORT))" --host 127.0.0.1 --log-file "((LOGFILE))"
ExecReload=/usr/bin/kill -HUP $MAINPID

# Stop
KillSignal=SIGINT

# Restart
Restart=always

[Install]
WantedBy=multi-user.target
